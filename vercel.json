{
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/promo-check",
      "schedule": "0 5 * * *"
    }
  ],
  "functions": {
    "api/promo-check.js": {
      "maxDuration": 60
    }
  }
}
